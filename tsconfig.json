{
  "compilerOptions": {
    "lib": ["ES2020", "dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": false,
    "strictNullChecks": true,
    "isolatedModules": true,
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["./source-code/"],
  "exclude": ["./source-code/**/backup*", "./source-code/**/--*", "public/**/*"]
}
